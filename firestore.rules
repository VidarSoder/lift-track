rules_version = '2';
// ===============================================================
// Assumed Data Model
// ===============================================================
// Collection: athletes
// Document ID: 64-char sha256 hex of (passphrase + server salt)
// Fields: name, timezone, programStartDate, lastSessionDate,
//   lastSessionStatus, lastByDay, prs, recent, sessionsCompleted,
//   streak, updatedAt
//
// Collection: athletes/{id}/sessions
// Document ID: YYYY-MM-DD
// Fields: date, dayId, title, status, startedAt, finishedAt,
//   timeOfDay, feelingBefore, feelingAfter, exercises, updatedAt
//
// Client SDK access is denied. All reads/writes go through the
// Next.js Admin SDK after a passphrase cookie check. Writes are
// limited to the single athlete doc and today's session.
// ===============================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
