rules_version = '2';
// ===============================================================
// Assumed Data Model
// ===============================================================
// Collection: athletes
// Document ID: 64-char sha256 hex of (passphrase + server salt)
// Fields: name, timezone, programStartDate, lastSessionDate,
//   lastSessionStatus, lastByDay, customExercises, pinnedByDay, prs, recent, sessionsCompleted,
//   streak, stretchSessionsCompleted, updatedAt
//
// Collection: athletes/{id}/sessions
// Document ID: YYYY-MM-DD__dayId__sessionStartedAt (legacy: YYYY-MM-DD)
// Fields: date, dayId, title, status, startedAt, finishedAt,
//   timeOfDay, feelingBefore, feelingAfter, exercises, updatedAt
//
// Collection: athletes/{id}/setLogs
// Document ID: date__dayId__exerciseId__kind__setIndex__sessionStartedAt
// Fields: date, dayId, title, exerciseId, kind (work|warmup|extra),
//   setIndex, weight, reps, done, sessionStatus, sessionStartedAt, loggedAt
// Append-only durable history. Same key may be merged while editing; never deleted.
//
// Client SDK access is denied. All reads/writes go through this
// website's Next.js API (origin-locked) using the Admin SDK after
// a passphrase cookie check. Writes are limited to the single
// athlete document and today's session.
// ===============================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
